import Mathlib
import MPrivate.NS.ThirdCoefficient.SpectralSignedStretching

namespace MPrivate.NS.ThirdCoefficient

/-!
# EightTermSignedGrouping

Exact signed regrouping of the eight low/high interactions generated by
`(S_L+S_H)(omega_L+omega_H)^2` in the scalar model.

No absolute values are introduced. The purpose is to expose the six genuinely
different interaction classes before any analytic estimate is applied.
-/

/-- Pure low interaction. -/
def VLLL (sL wL : ℝ) : ℝ := sL * wL * wL

/-- Low strain with one low and one high vorticity; scalar symmetry combines two terms. -/
def VLLHpair (sL wL wH : ℝ) : ℝ := 2 * sL * wL * wH

/-- Low strain acting on two high vorticity factors. -/
def VLHH (sL wH : ℝ) : ℝ := sL * wH * wH

/-- High strain acting on two low vorticity factors. -/
def VHLL (sH wL : ℝ) : ℝ := sH * wL * wL

/-- High strain with one low and one high vorticity; scalar symmetry combines two terms. -/
def VHLHpair (sH wL wH : ℝ) : ℝ := 2 * sH * wL * wH

/-- Pure high interaction. -/
def VHHH (sH wH : ℝ) : ℝ := sH * wH * wH

/-- Six-block signed grouping of all eight original terms. -/
def sixBlockStretching
    (sL sH wL wH : ℝ) : ℝ :=
  VLLL sL wL +
  VLLHpair sL wL wH +
  VLHH sL wH +
  VHLL sH wL +
  VHLHpair sH wL wH +
  VHHH sH wH

/-- Exact regrouping: no triangle inequality and no sign loss. -/
theorem eight_terms_equal_six_signed_blocks
    (sL sH wL wH : ℝ) :
    spectralStretchingExpanded sL sH wL wH =
      sixBlockStretching sL sH wL wH := by
  unfold spectralStretchingExpanded sixBlockStretching
    VLLL VLLHpair VLHH VHLL VHLHpair VHHH
  ring

/-- The original unsplit stretching equals the six-block signed grouping. -/
theorem spectral_stretching_equals_six_blocks
    (sL sH wL wH : ℝ) :
    spectralStretchingScalar sL sH wL wH =
      sixBlockStretching sL sH wL wH := by
  rw [spectral_signed_expansion]
  exact eight_terms_equal_six_signed_blocks sL sH wL wH

/-- Cross/mixed block, preserving signs internally. -/
def mixedSignedBlock
    (sL sH wL wH : ℝ) : ℝ :=
  VLLHpair sL wL wH +
  VLHH sL wH +
  VHLL sH wL +
  VHLHpair sH wL wH

/-- Pure endpoints plus the signed mixed block. -/
theorem six_blocks_as_endpoints_plus_mixed
    (sL sH wL wH : ℝ) :
    sixBlockStretching sL sH wL wH =
      VLLL sL wL + mixedSignedBlock sL sH wL wH + VHHH sH wH := by
  unfold sixBlockStretching mixedSignedBlock
  ring

/-- A cancellation witness inside the mixed block: opposite strain components
can cancel exactly for equal low/high scalar vorticity factors. -/
theorem mixed_block_exact_cancellation_witness :
    mixedSignedBlock 1 (-1) 1 1 = 0 := by
  norm_num [mixedSignedBlock, VLLHpair, VLHH, VHLL, VHLHpair]

end MPrivate.NS.ThirdCoefficient
