import G1_KAdmissible_to_SignedDepletion

/-!
Flexible material operator for the NS producer-first route.

This file is intended to be checked in the same concatenated environment as
ProducerFirst.lean + SignedGainCore.lean + G1MaterialUnified.lean.
-/

noncomputable section

namespace MillenniumAudit.G1KAdmissible

/--
Three-piece stretching decomposition:
stretch = bulk + tail + remainder.

The bulk and exceptional tail are absorbed into viscosity with a strict common
budget.  The remainder is allowed to be lower-order, controlled by a
nonnegative coefficient a(t) times enstrophy y(t).
-/
structure FlexibleBulkTailRemainder
    (ν : ℝ)
    (d : EnstrophyData) where
  bulk : ℝ → ℝ
  tail : ℝ → ℝ
  remainder : ℝ → ℝ

  cBulk : ℝ
  cTail : ℝ
  a : ℝ → ℝ

  cBulk_nonneg : 0 ≤ cBulk
  cTail_nonneg : 0 ≤ cTail
  budget : cBulk + cTail < 1
  a_nonneg : ∀ t, 0 ≤ a t

  split :
    ∀ t,
      d.stretch t = bulk t + tail t + remainder t

  bulk_bound :
    ∀ t, bulk t ≤ cBulk * ν * d.z t

  tail_bound :
    ∀ t, tail t ≤ cTail * ν * d.z t

  remainder_bound :
    ∀ t, remainder t ≤ a t * d.y t

/--
The three-piece material certificate produces exactly the flexible stretching
bound with theta = cBulk+cTail.
-/
def FlexibleBulkTailRemainder.toFlexibleStretchingBound
    {ν : ℝ}
    {d : EnstrophyData}
    (H : FlexibleBulkTailRemainder ν d) :
    FlexibleStretchingBound ν (H.cBulk + H.cTail) d where
  a := H.a
  hθ0 := add_nonneg H.cBulk_nonneg H.cTail_nonneg
  hθ1 := H.budget
  ha := H.a_nonneg
  stretching := by
    intro t
    rw [H.split t]
    have hb := H.bulk_bound t
    have ht := H.tail_bound t
    have hr := H.remainder_bound t
    nlinarith

/--
Exact differential consequence.  This is the PDE bookkeeping calculation:

  y'/2 + ν z = stretch
  stretch ≤ θ ν z + a y

therefore

  y' + 2(1-θ)ν z ≤ 2 a y,

with θ=cBulk+cTail<1.
-/
theorem flexible_bulk_tail_differential
    {ν : ℝ}
    {d : EnstrophyData}
    (H : FlexibleBulkTailRemainder ν d)
    (B : EnstrophyBalance ν d) :
    ∀ t,
      d.yDerivative t +
        2 * (1 - (H.cBulk + H.cTail)) * ν * d.z t
      ≤ 2 * H.a t * d.y t :=
  G2a_enstrophy_differential
    ν (H.cBulk + H.cTail) d B
    H.toFlexibleStretchingBound

/--
Strict dissipative margin generated by the common budget.
-/
def FlexibleBulkTailRemainder.delta
    {ν : ℝ}
    {d : EnstrophyData}
    (H : FlexibleBulkTailRemainder ν d) : ℝ :=
  1 - (H.cBulk + H.cTail)

theorem FlexibleBulkTailRemainder.delta_pos
    {ν : ℝ}
    {d : EnstrophyData}
    (H : FlexibleBulkTailRemainder ν d) :
    0 < H.delta := by
  unfold FlexibleBulkTailRemainder.delta
  linarith [H.budget]

/--
A quadratic lower-order remainder is the exact form consumed by the canonical
SignedGainCore: remainder ≤ C*y^2.
-/
structure QuadraticBulkTailRemainder
    (ν : ℝ)
    (d : EnstrophyData) where
  bulk : ℝ → ℝ
  tail : ℝ → ℝ
  remainder : ℝ → ℝ

  cBulk : ℝ
  cTail : ℝ
  C : ℝ

  cBulk_nonneg : 0 ≤ cBulk
  cTail_nonneg : 0 ≤ cTail
  budget : cBulk + cTail < 1

  split :
    ∀ t,
      d.stretch t = bulk t + tail t + remainder t

  bulk_bound :
    ∀ t, bulk t ≤ cBulk * ν * d.z t

  tail_bound :
    ∀ t, tail t ≤ cTail * ν * d.z t

  remainder_bound :
    ∀ t, remainder t ≤ C * (d.y t)^2

end MillenniumAudit.G1KAdmissible

namespace NSProducerFirst

open MillenniumAudit.G1KAdmissible

/--
Projection of the richer quadratic bulk/tail/remainder estimate into the
canonical producer-first SignedGainCore.
-/
def signedGainCore_of_quadratic_bulk_tail
    {ν : ℝ}
    (d : MillenniumAudit.G1KAdmissible.EnstrophyData)
    (H : QuadraticBulkTailRemainder ν d) :
    SignedGainCore ν (EnstrophyData.ofG1 d) where
  theta := H.cBulk + H.cTail
  C := H.C
  htheta1 := H.budget
  stretching := by
    intro t
    change d.stretch t ≤
      (H.cBulk + H.cTail) * ν * d.z t + H.C * (d.y t)^2
    have hs := H.split t
    have hb := H.bulk_bound t
    have ht := H.tail_bound t
    have hr := H.remainder_bound t
    rw [hs]
    nlinarith

/--
The strict-budget zero-remainder route is the special case C=0.
-/
def strictBulkTail_as_quadratic
    {ν : ℝ}
    (d : MillenniumAudit.G1KAdmissible.EnstrophyData)
    (s : MillenniumAudit.G1KAdmissible.StretchSplit d)
    (cBulk cTail : ℝ)
    (hBulk : MillenniumAudit.G1KAdmissible.BulkAbsorption ν cBulk d s)
    (hTail : MillenniumAudit.G1KAdmissible.ExceptionalTailControl ν cTail d s)
    (hBudget : MillenniumAudit.G1KAdmissible.SubcriticalBudget cBulk cTail) :
    QuadraticBulkTailRemainder ν d where
  bulk := s.bulk
  tail := s.tail
  remainder := fun _ => 0
  cBulk := cBulk
  cTail := cTail
  C := 0
  cBulk_nonneg := hBulk.1
  cTail_nonneg := hTail.1
  budget := hBudget
  split := by
    intro t
    rw [s.split t]
    ring
  bulk_bound := hBulk.2
  tail_bound := hTail.2
  remainder_bound := by
    intro t
    simp

#print axioms MillenniumAudit.G1KAdmissible.FlexibleBulkTailRemainder.toFlexibleStretchingBound
#print axioms MillenniumAudit.G1KAdmissible.flexible_bulk_tail_differential
#print axioms MillenniumAudit.G1KAdmissible.FlexibleBulkTailRemainder.delta_pos
#print axioms NSProducerFirst.signedGainCore_of_quadratic_bulk_tail
#print axioms NSProducerFirst.strictBulkTail_as_quadratic

end NSProducerFirst
