import Mathlib

namespace MPrivate.NS.ThirdCoefficient

/-- Pure algebraic model of the signed low/high expansion of `S ω ω`.
    It deliberately expands the signed trilinear expression before taking norms. -/
def spectralStretchingScalar
    (sLow sHigh wLow wHigh : ℝ) : ℝ :=
  (sLow + sHigh) * (wLow + wHigh) ^ 2

/-- Eight signed interactions generated by the low/high decomposition. -/
def spectralStretchingExpanded
    (sLow sHigh wLow wHigh : ℝ) : ℝ :=
  sLow * wLow * wLow +
  sLow * wLow * wHigh +
  sLow * wHigh * wLow +
  sLow * wHigh * wHigh +
  sHigh * wLow * wLow +
  sHigh * wLow * wHigh +
  sHigh * wHigh * wLow +
  sHigh * wHigh * wHigh

/-- Exact signed decomposition.  No triangle inequality has been applied. -/
theorem spectral_signed_expansion
    (sLow sHigh wLow wHigh : ℝ) :
    spectralStretchingScalar sLow sHigh wLow wHigh =
      spectralStretchingExpanded sLow sHigh wLow wHigh := by
  unfold spectralStretchingScalar spectralStretchingExpanded
  ring

/-- Group the expansion into low-strain and high-strain contributions while
    preserving all cross terms. -/
theorem spectral_signed_two_block
    (sLow sHigh wLow wHigh : ℝ) :
    spectralStretchingScalar sLow sHigh wLow wHigh =
      sLow * (wLow + wHigh) ^ 2 +
      sHigh * (wLow + wHigh) ^ 2 := by
  unfold spectralStretchingScalar
  ring

/-- The next PDE-level task is to control the signed sum, not the sum of the
    absolute values of the eight interactions. -/
def SpectralCancellationGoal
    (total diss coeff enstrophy ε K : ℝ) : Prop :=
  total ≤ ε * diss + K * coeff * enstrophy

end MPrivate.NS.ThirdCoefficient
